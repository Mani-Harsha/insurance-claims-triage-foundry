{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Claims: initialize",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "claims_triage", "init"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Claims: triage synthetic fixture",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "claims_triage", "triage", "data/claims.json", "--synthetic"],
      "options": { "cwd": "${workspaceFolder}", "env": { "TRIAGE_MODE": "mock" } },
      "dependsOn": "Claims: initialize",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Claims: tests",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pytest", "-q", "--basetemp=.pytest-vscode-tmp"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Claims: lint",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "ruff", "check", "src", "tests"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
